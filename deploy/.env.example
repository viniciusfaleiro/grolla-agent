# Copie para deploy/.env (nunca commite o .env) e preencha.
GROLLA_VERSION=0.0.4
GROLLA_TEAM_CONFIG=credenciadora.yaml
GROLLA_API_PORT=8000
GROLLA_LOG_LEVEL=INFO

# Senha do Postgres local da instância.
GROLLA_DB_PASSWORD=troque-por-uma-senha-forte

# Credenciais HTTP Basic que o canal de webhook do SigNoz usa para chamar /webhooks/alerts.
GROLLA_ALERTS_WEBHOOK_USER=signoz
GROLLA_ALERTS_WEBHOOK_PASSWORD=troque-por-uma-senha-forte

# URL do Workflow do Teams ("Post to a channel when a webhook request is received") do canal do time.
GROLLA_TEAMS_WEBHOOK_URL=https://exemplo.invalid/workflows/troque

# Investigação (S3).
# Chave da API da Anthropic (Claude), usada só pelo worker.
GROLLA_ANTHROPIC_API_KEY=troque
# Token (PAT) do Azure DevOps com escopo somente leitura: Build (Read) e Code (Read).
GROLLA_AZURE_DEVOPS_TOKEN=troque
# SigNoz para o container signoz-mcp: URL da instância e API key de papel Viewer.
GROLLA_SIGNOZ_URL=https://signoz.exemplo.invalid
GROLLA_SIGNOZ_API_KEY=troque

# AWS somente leitura para a investigação (ou deixe vazio e use a role da EC2).
# Política mínima: tag:GetResources, rds:Describe*, ec2:Describe*,
# elasticloadbalancing:Describe*, cloudtrail:LookupEvents, cloudwatch:DescribeAlarms.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
